# =============================================================================
# JobRadar configuration  —  copy this file to ".env" and fill in your keys.
#   cp .env.example .env
# Everything is free-tier. The app degrades gracefully: any source whose key is
# missing is simply skipped, so you can start with just GROQ_API_KEY and add the
# rest later. See README.md for where to get each key.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — AI (resume parsing, query generation, scoring, per-job reasoning)
# Get a free key at https://console.groq.com/keys  (starts with "gsk_")
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# RECOMMENDED — Job-search APIs (each free; missing ones are skipped)
# -----------------------------------------------------------------------------
# Jooble (aggregates Naukri/Indeed/etc.) — https://jooble.org/api/about
# They email a UUID key, usually within a day.
JOOBLE_API_KEY=

# Adzuna India (board aggregator w/ salaries) — https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SerpApi (Google Jobs) — https://serpapi.com/users/sign_up  (100 searches/month)
SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — SearxNG (Naukri + LinkedIn web-search aggregation)
# Leave empty to skip. To use the shared hosted instance, paste its URL.
# To self-host: deploy https://github.com/searxng/searxng to Render (free).
# -----------------------------------------------------------------------------
SEARXNG_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — Gmail job-alert scanner ("Scan Email" button)
# Imports postings from your job-alert emails and runs them through scoring + AI.
# Requires a Gmail APP PASSWORD (not your normal password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      App = "Mail", Device = "Other" (name it JobRadar) → Generate
#   3. Paste the 16-char password (remove spaces) below.
# Only senders you allowlist in Settings → Email are ever read.
# -----------------------------------------------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: restrict scanning to one Gmail label (e.g. "JobAlerts"). Empty = all mail.
GMAIL_LABEL=

# -----------------------------------------------------------------------------
# OPTIONAL — extra search providers (skipped if empty)
# -----------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_API_KEY=
BRAVE_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — access gate (for PUBLIC/hosted deployments)
# When set, every API call must carry this shared password (the frontend prompts
# for it once and remembers it). Leave EMPTY for local/Docker use — no gate.
# -----------------------------------------------------------------------------
# APP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — tuning (sensible defaults; usually leave as-is)
# -----------------------------------------------------------------------------
# SECRET_KEY=change-me-to-a-random-string
# SCRAPE_DELAY=1.0
# MAX_JOBS_PER_REFRESH=100

# NOTE: SQLITE_DB_PATH and FRONTEND_URL are set automatically by docker-compose.
#
# Turso (hosted SQLite) — REQUIRED for the Render+Vercel cloud deploy, since
# Render's free disk is ephemeral. Setting TURSO_DATABASE_URL flips the app to
# Turso automatically. Leave BOTH empty for local/Docker (uses local SQLite).
# Get them with the Turso CLI (see DEPLOY.md):
#   turso db show <db> --url        → TURSO_DATABASE_URL  (libsql://...)
#   turso db tokens create <db>     → TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
