# JobRadar Backend Environment Variables
# Copy this to .env and fill in your values

# Flask
FLASK_ENV=development
SECRET_KEY=dafsagbsjafs-bjfdkgbs-qqhurqcb

# Database (leave empty for local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Job Data APIs (Priority order) ──

# Jooble API (FREE — sign up at https://jooble.org/api/about)
# Aggregates jobs from Naukri, Indeed, and 1000s of Indian company sites
# This is the single best free source for Indian job market
JOOBLE_API_KEY=

# SerpApi (FREE 100 searches/month — sign up at https://serpapi.com)
# Google Jobs endpoint aggregates from ALL job portals
SERPAPI_API_KEY=


# Groq API (FREE — sign up at  https://console.groq.com) → Sign up → API Keys → Create → Copy
GROQ_API_KEY=

# Google Custom Search API (FREE 100 queries/day)
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Bing Web Search API (FREE 1000 queries/month)
# Get yours at: https://portal.azure.com
BING_API_KEY=

# Optional: Brave Search API (free, 2000/month)
BRAVE_SEARCH_API_KEY=

# Adzuna India API (FREE — sign up at https://developer.adzuna.com)
# India job aggregator with salary data. Free tier: ~250-1000 calls/month.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SearxNG self-hosted URL (Phase 2 — deploy searxng-jobradar repo to Render free tier)
# When set, used as primary SearxNG instance replacing flaky public ones
# See: https://github.com/searxng/searxng — deploy to Render, then paste URL here
SEARXNG_URL=

# ── Gmail job-alert scanner (Feature 1 — optional) ──
# Lets the "Scan Email" button import jobs from your job-alert emails
# (LinkedIn/Naukri/Indeed/etc.) and run them through scoring + AI analysis.
#
# Setup (one time):
#   1. Turn ON 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      → App = "Mail", Device = "Other" (name it "JobRadar") → Generate
#   3. Copy the 16-character password (remove spaces) into GMAIL_APP_PASSWORD below.
#   4. GMAIL_ADDRESS is your full Gmail address.
# Notes: a normal account password will NOT work — it must be an App Password.
#        Only emails from the sender allowlist (Settings → Email) are ever read.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: restrict scanning to a single Gmail label (e.g. "JobAlerts").
# Leave empty to search all mail (still limited to the sender allowlist).
GMAIL_LABEL=

# ── No API key needed for these (always active) ──
# Greenhouse API: Fetches from Stripe, Cloudflare, Coinbase, Razorpay, etc.
# Lever API: Fetches from Netflix, Atlassian, BrowserStack, PhonePe, etc.
# Career page URLs: Pre-filtered search links for 20 companies
# RemoteOK: Free remote job feed (no key needed)
# HackerNews Who is Hiring: Monthly startup hiring thread (no key needed)
# Arbeitnow: Free global remote job board (no key needed)
# Workable ATS: Remote-first startups (Deel, Automattic, Buffer, Zapier, etc.)
# SmartRecruiters ATS: Enterprise companies (Bosch, Visa, IBM, SAP, etc.)

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Scraping settings
SCRAPE_DELAY=1.0
MAX_JOBS_PER_REFRESH=100
